# Copier ce fichier en .env.local et renseigner les valeurs reelles.
# .env.local n'est jamais commite (voir .gitignore).

# --- Supabase --------------------------------------------------------------
# Projet Supabase (https://app.supabase.com). En local: valeurs affichees par
# `npm run supabase:start`.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cle service_role: acces complet, contourne Row Level Security.
# Jamais exposee au client, uniquement utilisee dans du code serveur.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application -------------------------------------------------------------
# URL publique de l'app (utilisee pour construire les webhooks Twilio).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- IA conversationnelle (Claude) -------------------------------------------
ANTHROPIC_API_KEY=

# --- Telephonie (Twilio Voice) ------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numero Twilio qui recoit les appels transferes par l'entreprise.
TWILIO_PHONE_NUMBER=+33000000000

# --- Transcription (Whisper) et synthese vocale (TTS) -------------------------
# Fournisseurs independants de Claude: remplacables sans toucher au reste.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# --- Notifications ------------------------------------------------------------
# Email (Resend) obligatoire par defaut pour limiter les couts.
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=notifications@votredomaine.fr
